{
  "name": "Clean Data",
  "slug": "clean-data",
  "output": {"type": "animated data insert (graph / route / exploded view)", "aspect": "9:16", "w": 1080, "h": 1920, "fps": 30, "length_s": [4.0, 4.2], "deliver": ["mp4", "contact sheet jpg"]},
  "type": {
    "ui": {"font": "Inter", "weights": [500, 600, 700]},
    "number": {"font": "Inter Tight", "weight": 700, "px": 180, "line_height": 1, "tracking_em": -0.05, "tabular": true, "fit_w_px": 850},
    "mono": {"font": "JetBrains Mono", "weight": 500},
    "sizes_px": {"graph_label": 34, "graph_axis": 26, "eta_title": 34, "eta_sub": 25, "card_name": 38, "card_detail": 28, "street_label": 27, "teardown_header": 26, "label_number": 24, "label_name": 31, "label_note": 20}
  },
  "colour_roles": {
    "background": {"graph_light": "#FFFFFF", "graph_dark": "#000000", "route": "#EEF0F1", "teardown": ["#2A2D33", "#16181B", "#0A0B0D"]},
    "text": {"light": "#000000", "dark": "#FFFFFF", "card": "#16181B", "teardown": "#F3F1ED"},
    "muted": {"light": "#8C8C8C", "dark": "#8A8A8A", "card": "#6B6F75", "street": "#77797C", "teardown": "#8B9098"},
    "axis": {"light": "#A3A3A3", "dark": "#707070"},
    "grid": {"light": "#E6E6E6", "dark": "#262626"},
    "accent": {"route": "#2F7CF6", "teardown": "#F08A5D"},
    "pin": "#F0483E",
    "leader": "#C9CCD1",
    "map": {"ground": "#F7F7F5", "building": "#FFFFFF", "plaza": "#E6E6E2", "park": "#D3E9C6", "trees": ["#8FCD78", "#7CBF68"], "river": "#9FCBF2"}
  },
  "motion": {
    "graph": {
      "axes": {"dur_s": 0.45, "ease": "power3.out", "starts_s": [0, 0.06, 0.12]},
      "axis_labels": {"dur_s": 0.3, "ease": "power1.out", "from_s": 0.1, "stagger_s": 0.03},
      "tip_in": {"at_s": 0.3, "dur_s": 0.15},
      "line": {"from_s": 0.3, "dur_s": 2.7, "ease": "power1.inOut", "curve": "Catmull-Rom 0.5"},
      "count": "value under the tip x final / last value; exact final at 3.0 s",
      "landing": {"ring_r_px": [13, 60], "ring_opacity": [0.18, 0], "ring_s": 0.7, "ring_ease": "power2.out", "drop_s": 0.45, "drop_ease": "power2.inOut", "drop_dash": [3, 9]}
    },
    "route": {
      "labels_in_s": [0.15, 0.5],
      "draw_s": [0.25, 2.75], "draw_ease": "quad inOut",
      "camera": {"fov_deg": 30, "dist": [62, 48, 78], "intro_s": 1.0, "polar_deg": [30, 38, 28], "azimuth_deg": [28, 10], "pullback_from_s": 2.45},
      "pin": {"at_s": 2.62, "drop_h": 9, "fall_s": 0.28, "bounce_h": 1.1, "bounce_end_s": 0.5, "squash": 0.18},
      "card_in_s": [3.07, 3.32], "card_rise_px": 16,
      "eta": "N min counting down, then Arrived"
    },
    "teardown": {
      "yaw_deg": [-33, -23], "sway_deg": 2,
      "explode": {"from_s": 0.45, "each_s": 1.25, "stagger_s": 0.07, "ease": "cubic inOut", "order": "top layer first"},
      "leaders": {"from_s": 1.05, "stagger_s": 0.13, "each_s": 0.3, "stroke_px": 2},
      "render": {"tone_mapping": "ACES filmic", "exposure": 1.05, "fov_deg": 26, "key": 2.2, "rim": 1.2, "hemi": 0.45}
    },
    "motion_blur": "not applied yet"
  },
  "captions": {"inside_beat": "none", "label": "plain noun"},
  "layout_px": {
    "safe": {"top": 220, "bottom_y": 1500, "side": 100},
    "graph": {"label": [120, 330], "number": [114, 382], "chart_x": [120, 940], "zero_y": 1330, "max_y": 770, "grid_y": [770, 1050, 1330], "axis_label_y": 1388, "line_px": 6, "tip_r": 13},
    "route": {"eta": [110, 250], "eta_radius": 28, "card_radius": 26, "card_clamp_x": [100, 980], "label_zone": {"x": [140, 940], "y": [400, 1560]}},
    "teardown": {"header": [110, 250], "label_x": 690, "label_w": 250, "label_y0": 470, "label_step": 170, "label_y_max": 1440, "label_y_min": 400}
  },
  "sound": {"templates": "silent", "in_edit": "one tick or whoosh on the line start, a light thud on the landing, 12 dB or more under the voice"},
  "pacing": {"beat_s": [4.0, 4.2], "cut": "hard", "hold": "optional seconds on the last frame", "min_read_end_s": 0.8},
  "specs": {
    "graph": {"label": "Followers", "values": [1.2, 2.1, 3.4, 5, 9, 24, 51, 78, 100], "labels": ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep"], "final": 100000, "prefix": "", "suffix": "", "decimals": 0, "dark": false, "hold": 0},
    "route": {"destination": "Central Station", "minutes": 28, "distance": 23, "unit": "km", "places": ["Old Town", "North Park", "Market", "East Gardens", "River"], "accent": "#2F7CF6", "seed": 7},
    "teardown": {"title": "Phone", "subtitle": "Exploded view", "labels": [["Cover glass", "toughened 0.6 mm"], ["OLED display", "6.3 in, 120 Hz"], ["Frame", "grade 5, 7.8 mm"], ["Logic board", "3 nm chip, 8 GB"], ["Battery", "3,582 mAh"], ["Back glass", "matte, magnet ring"]], "time": "9:41", "date": "Saturday 1 November", "accent": "#F08A5D"}
  },
  "bans": ["invented data", "arrows, badges, chips, slogans", "more than one accent", "gradients on data", "text in the top 220 px or below y 1500", "labels over the object or the ETA card", "ending on a moving frame"],
  "skin_slots": {
    "font_ui": "label and card font",
    "font_number": "big number font",
    "font_mono": "teardown header and notes font",
    "mode": "light or dark plate for the graph",
    "accent": "the one accent colour",
    "pin": "destination pin colour",
    "place_names": "five place labels for the route city"
  }
}
