    "meme": {"key": "clip((G - max(R,B) - 25) / 40, 0, 1)", "anchor": "bottom centre", "w_px": [700, 1050], "centre_figure_w_px": 860, "win_card": {"scale": 1.15, "y": 330}, "label_gap_px": 70, "min_per_video": 1, "per_batch": "once each"},
