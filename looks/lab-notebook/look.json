{
  "name": "Lab Notebook",
  "slug": "lab-notebook",
  "output": {"type": "faceless narrated explainer reel", "aspect": "9:16", "size": [1080, 1920], "fps": 30, "length_s": [60, 110], "deliver": ["mp4"], "keep": ["episode spec", "script.txt", "vo takes", "vo.mp3", "mix.wav"]},
  "type": {
    "family": "Inter",
    "weights": {"headline": 800, "title": 700, "caption": 700, "caption_hot": 800, "big_number": 200},
    "title": {"px": 66, "weight": 800, "line_height": 1.12, "tracking": "-0.015em", "lines": 2, "top_y": 470, "line2": "accent"},
    "big_number": {"px": 230, "weight": 200, "tracking": "-0.03em", "top_y": 670, "colour": "accent", "figures": "tabular"},
    "big_label": {"px": 38, "weight": 700, "top_y": 910},
    "caption": {"px": 42, "weight": 700, "max_width_px": 900, "shrink_to_fit": true},
    "pill_px": [26, 34],
    "list_row_px": 42
  },
  "colour_roles": {
    "paper": "#F5F3EC",
    "paper_glow": "#FFFFFF",
    "grid": "rgba(0,0,0,0.035)",
    "ink": "#000000",
    "text": "#3B3A35",
    "muted": "#8C8A80",
    "line": "#DFDDD0",
    "accent": "#2563EB",
    "accent_light": "#5B8DEF",
    "accent_deep": "#1D4ED8",
    "accent_soft": "#DCE7FD"
  },
  "motion": {
    "fps": 30,
    "entrance": {"ease": "power3.out", "frames": [15, 23], "rise_px": [10, 30]},
    "orb_in": {"ease": "power3.out", "frames": 23, "scale_from": 0.55, "blur_from_px": 14},
    "draw_on": {"ring": {"ease": "power3.out", "frames": 33}, "drawing": {"ease": "power2.inOut", "frames": 45, "stagger_frames": 4}, "link": {"ease": "power2.inOut", "frames": 18}, "curve": {"ease": "power2.inOut", "frames": 42}},
    "pop_in": {"ease": "back.out(1.6-2)", "frames": [13, 14]},
    "count_up": {"ease": "power3.out", "tick_scale": 1.06, "tick_frames": 5},
    "spark": {"ease": "power2.inOut", "frames": 30, "rest_frames": 9},
    "transition": {"fade": {"in_frames": 10, "out_frames": 9}, "pan": {"ease": "power3.inOut", "frames": 28, "travel": 0.55}, "cut": "scene 1 only"},
    "hold_drift": {"scale": [1.0, 1.035], "ease": "power1.inOut"},
    "dead_air_bloom": {"px": 680, "peak_opacity": 0.3, "in_frames": 14, "out_frames": 24},
    "focus_dim": 0.28,
    "board_never_scales": true,
    "motion_blur": {"render_fps": 120, "subframes_blended": 2, "shutter_deg": 180}
  },
  "captions": {
    "lines": 1,
    "y": 1330,
    "max_chars": 24,
    "break_on_pause_s": 0.45,
    "merge_under_s": 0.45,
    "min_on_screen_s": 0.4,
    "hold_after_last_word_s": 0.6,
    "in": {"rise_px": 8, "frames": 4, "ease": "power2.out"},
    "highlight": "accent, weight 800",
    "halo": "paper colour text-shadow 18/6/2 px"
  },
  "layout": {"title_band": [470, 620], "visual_centre": [540, 930], "source_pill_y": [1240, 1260], "caption_y": 1330, "corner_mark": {"x": 64, "y": 96, "h": 40}, "ring_max_r": 290, "grid_px": 54},
  "sound": {
    "vo_lufs": -16,
    "bed_lufs": -31,
    "bed": {"ducked": false, "compressed": false, "fade_in_s": 1.0, "fade_out_s": 2.5, "bpm": 108},
    "sfx_db": {"pop": -21, "whoosh": -19, "chime": -18, "tick": -24, "riser": -15},
    "sfx_align": {"pop": "onset", "whoosh": "peak", "chime": "onset", "tick": "onset", "riser": "peak"},
    "sfx_on": {"pop": "every landing", "whoosh": "every pan", "tick": "count-ups", "chime": "stat lands", "riser": "into the hook"},
    "master": {"lufs": -14, "true_peak_dbtp": -1.2, "limiter": "alimiter limit 0.86, attack 5 ms, release 80 ms"}
  },
  "pacing": {"new_element_every_s": [1, 3], "scene_s": [5, 13], "max_dead_air_s": 1.6, "first_visual_after_keyword_max_s": 0.4, "tail_s": 1.6, "open": "question or tension", "close": "one CTA line + end card"},
  "bans": [
    "second identity colour",
    "faces, presenters, photos, before/after imagery",
    "result shown before the VO says it",
    "whole board scaling on a beat",
    "overlaps, text over the caption, text out of its box",
    "VO over 1.6 s with nothing new landing",
    "radial-gradient/filter/clip-path on more than ~40 elements per scene",
    "tweening to CSS variable colours",
    "HyperFrames' own MP4 encode for finals"
  ],
  "skin_slots": {
    "font_family": "the one font family; needs weights 200, 700 and 800",
    "font_file": "variable font file used by the composition",
    "paper": "base background colour",
    "paper_glow": "drifting glow colour behind the board",
    "grid": "grid line colour, alpha near 0.035",
    "ink": "line art, titles, captions",
    "text": "secondary text",
    "muted": "counts, axis text, neutral dots and curves",
    "line": "bars, bonds, outlines, timeline track",
    "accent": "the single identity colour",
    "accent_light": "orb rims and dashed slots",
    "accent_deep": "gradient ends and pill text",
    "accent_soft": "pill, chip halo and step fills",
    "corner_mark": "small mark top-left, file path or null",
    "end_mark": "end card mark, file path or wordmark text",
    "end_url": "URL pill on the end card",
    "end_note": "small line under the URL, empty to hide",
    "cta_line": "the one spoken CTA line",
    "vo_voice": "narrator voice name or id",
    "vo_language": "VO and caption language, and which terms stay in English",
    "music_bed": "instrumental bed file"
  }
}
