{
  "name": "Cream Stop-Motion",
  "slug": "cream-stop-motion",
  "output": {"type": "character skit / trend remake", "aspect": "9:16", "size": [1080, 1920], "fps": 24, "draw_on": "twos", "length_s": [6, 22], "deliver": ["mp4", "pose contact sheets", "episode json", "post caption"]},
  "type": {
    "caption": {"font": "Inter Bold", "px": 46, "colour_role": "caption_ink", "outline": "none", "shadow": "none on the cream set", "line_height": 1.3, "cx": 540, "cy": [590, 600], "punchline_cy": 450, "case": "sentence", "max_chars": 40, "max_line_chars": 30, "max_lines": 2},
    "handle": {"font": "Inter Bold", "px": 30, "colour_role": "handle_ink", "y": 1840},
    "painted_set_caption": {"ink": "#FFFFFF", "shadow": {"blur": 4, "offset": [2, 3], "alpha": 190}}
  },
  "colour_roles": {
    "set_bg": "#FCF4DB",
    "caption_ink": "#816B4C",
    "handle_ink": "#282828",
    "floor_shadow": "rgba(150,120,80,50)",
    "mark_tick": "#F6C440",
    "mark_heart": "#F4728A",
    "pose_backdrop": "flat mid-grey (pure white for grey-clothed characters, never white for white characters)"
  },
  "motion": {
    "fps_note": "frames at 24 fps",
    "update": "every 2 frames",
    "boil": {"x_px": 3, "y_px": 2, "rot_deg": 0.8, "seeded": true},
    "mouth": {"pair": ["_c", "_o"], "rhythm": "open on 2 of every 3 steps while voiced", "speech_thr": "max(0.02, 0.6 * p60 rms)", "song_thr": "max(0.01, mouth_thr * p95 vocal-stem rms)", "song_mouth_thr_default": 0.25},
    "new_pose_squash": {"formula": "1 + 0.06 * exp(-14 t)", "frames": 6, "w": "x s", "h": "/ sqrt(s)"},
    "ticks": {"strokes": 3, "angles_deg": [-50, -15, 20], "r_px": [34, 62], "wobble_px": 6, "width_px": 9},
    "hearts": {"head_size": 36, "bob_px": 6, "float": 4, "float_size": 22, "rise_px": 120, "shrink": 0.4, "cycles_per_s": 0.6},
    "more_crazy": {"pose_every_s": [0.15, 0.25], "min_poses": 15},
    "camera": "one fixed camera, no moves, no zooms",
    "motion_blur": "none"
  },
  "captions": {"per_beat": 1, "timing": "beat start to next beat start", "silent_beat": "...", "caps_words_per_line": 1},
  "elements": {
    "character": {"h_px": 640, "h_two_shot_px": 600, "feet_y": 1290, "x_solo": 0.5, "x_pair": [0.29, 0.71], "min_gap": 0.4, "max_on_stage": 2, "floor_shadow_px": [340, 36], "pinned": "bottom-centre, 20 px margin"},
    "pose_gen": {"model": "FLUX.2 klein class image edit, 4 steps", "size": [768, 1024], "chain": false, "seed": "fixed", "suffix": "front view, full body centred, standing, flat backdrop, soft even studio light, clay 3D render, exactly two arms and two paws, no symbols"},
    "cutout": {"model": "BiRefNet-HR class", "drop_specks_below": 0.02},
    "painted_set": {"size": [720, 1280], "lying_shadow": {"blur": 9, "alpha": 0.4, "offset": [10, 14]}, "water_streaks": 70}
  },
  "sound": {
    "voice": {"takes_per_line": 1, "max_tags_per_line": 1, "trim_db": -40, "trim_pad_s": 0.03, "lead_s": 0.3, "end_s": 0.6},
    "beat": {"tail_default_s": 0.15, "punchline_tail_s": [0.8, 1.0], "deadpan_hold_s": [0.3, 0.5], "silent_dur_s": [0.4, 3.0]},
    "sfx_db": {"pop_new_pose": -14, "boing": -8, "sparkle": -10, "scratch": -3},
    "max_simultaneous": 2,
    "music": "none in skits; the trend sound itself in remakes",
    "master_lufs": -14, "limiter_ceiling": 0.708, "true_peak_dbtp": -1, "codec": "AAC 192k 48 kHz stereo", "video": "H.264 CRF 16 yuv420p"
  },
  "pacing": {
    "setup_within_s": [1, 2],
    "lines": [3, 9], "good_lines": [4, 8],
    "voiced_chars_max": 260, "voiced_chars_typical": [60, 200],
    "frames_drawn": [10, 18], "frames_max": 24,
    "line_30_chars_s": 2.5,
    "cuts": "none"
  },
  "bans": [
    "one still slid, scaled, bounced or swayed", "camera moves or zooms", "emoji, labels, flying props",
    "outlined captions or pills", "lying, sitting or jumping poses on the cream set",
    "leg straight up or bicycle in pose words", "copied characters, lines or drawings",
    "swearing of any kind", "jokes about death, war, guns, drugs, alcohol, vaping or sex",
    "more than two characters on stage", "hashtags in the post caption"
  ],
  "skin_slots": {
    "characters": "list of character slots: name, reference image, look anchor words, voice id, personality, speaking style, backdrop, pose-id prefix",
    "hero_prop": "the one allowed object: pose words and reference image (optional)",
    "set_bg": "hex: cream set colour",
    "caption_ink": "hex: caption text colour",
    "handle_ink": "hex: handle text colour",
    "mark_tick": "hex: '!' tick colour",
    "mark_heart": "hex: heart colour",
    "font_caption": "caption and handle font file",
    "handle_text": "account handle printed at the bottom",
    "tts_model": "voice model for every line",
    "sfx_kit": "folder of named SFX wavs",
    "banned_words": "words the script and poses never use",
    "post_caption_style": "example post captions"
  }
}
